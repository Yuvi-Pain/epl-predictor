# Copy this file to .env and change the password. .env is git-ignored.

# Used by the postgres container to create the database on first start.
POSTGRES_USER=epl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=epl

# Used by the backend. Hostnames are the service names from docker-compose.yml.
# Keep the user/password/db here in sync with the values above.
DATABASE_URL=postgresql+asyncpg://epl:change-me@postgres:5432/epl
REDIS_URL=redis://redis:6379/0
