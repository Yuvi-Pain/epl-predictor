# Copy this file to .env and change the password. .env is git-ignored.

# Used by the postgres container to create the database on first start.
POSTGRES_USER=epl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=epl

# Used by the backend. Hostnames are the service names from docker-compose.yml.
# Keep the user/password/db here in sync with the values above.
DATABASE_URL=postgresql+asyncpg://epl:change-me@postgres:5432/epl
REDIS_URL=redis://redis:6379/0

# Which trained model the API loads at startup: backend/models/match_outcome_logreg_<version>.joblib.
# Set MODEL_PATH instead to point at a specific file.
MODEL_VERSION=v2

# football-data.org API key for the fixture list (free: https://www.football-data.org/client/register).
# Without it the worker still loads results but skips the fixture refresh.
FOOTBALL_DATA_API_KEY=your-key-here
# How often the worker refreshes fixtures and reloads results, in hours.
FIXTURES_REFRESH_HOURS=6
HISTORY_REFRESH_HOURS=24
